{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "StoryLens",
  "version": "0.1.0",
  "identifier": "local.storylens.editor",
  "build": { "beforeDevCommand": "npm run dev", "devUrl": "http://localhost:1420", "beforeBuildCommand": "npm run build", "frontendDist": "../dist" },
  "app": {
    "windows": [{ "title": "StoryLens", "width": 1280, "height": 860, "minWidth": 900, "minHeight": 620 }],
    "security": { "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; object-src 'none'; frame-src 'none'; base-uri 'none'" }
  },
  "bundle": { "active": false }
}
